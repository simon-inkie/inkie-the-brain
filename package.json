{
  "name": "the-brain",
  "version": "0.2.0",
  "description": "Long-term memory for AI coding agents. Survives compaction. Searchable across sessions. Filesystem-first.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "index": "tsx cli/index.ts index",
    "index-messages": "tsx cli/index.ts index-messages",
    "index-assets": "tsx cli/index.ts index-assets",
    "search": "tsx cli/index.ts search",
    "stats": "tsx cli/index.ts stats",
    "context": "tsx cli/index.ts context",
    "cross-link": "tsx cli/index.ts cross-link",
    "assets": "tsx cli/index.ts assets",
    "agent": "tsx cli/index.ts agent",
    "watch": "tsx daemon/watcher.ts"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@qdrant/js-client-rest": "^1.17.0",
    "chokidar": "^5.0.0",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.2",
    "openclaw": "^2026.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "author": "Simon <simon@inkie.ink>",
  "license": "MIT"
}
