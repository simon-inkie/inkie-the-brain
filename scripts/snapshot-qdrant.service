# Daily Qdrant maintenance: systemd user service TEMPLATE.
#
# Do not copy this by hand: scripts/install-timer.sh fills in the placeholders with
# the checkout path, so the checkout can live anywhere and have any name.
[Unit]
Description=Daily Qdrant maintenance — snapshot + drift check + auto-reindex
Documentation=file://@BRAIN_ROOT_URL@/README.md
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart="@BRAIN_ROOT@/scripts/snapshot-qdrant.sh"
# Redirect output to journal — view with `journalctl --user -u snapshot-qdrant`
StandardOutput=journal
StandardError=journal
# Guard against runaway jobs
TimeoutStartSec=600
# Don't restart — if it fails, the timer will run it again next cycle
Restart=no
