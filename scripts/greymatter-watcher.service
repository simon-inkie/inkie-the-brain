# Greymatter File Watcher — systemd user service
#
# Install:
#   cp scripts/greymatter-watcher.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable greymatter-watcher
#   systemctl --user start greymatter-watcher
#
# Check status:
#   systemctl --user status greymatter-watcher
#   journalctl --user -u greymatter-watcher -f
#
# Stop:
#   systemctl --user stop greymatter-watcher

[Unit]
Description=Greymatter File Watcher — auto-indexes brain + memory files into Qdrant
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/simon/io-projects/greymatter
ExecStart=/home/simon/.local/share/pnpm/pnpm watch
Restart=on-failure
RestartSec=5
EnvironmentFile=/home/simon/io-data/.env

[Install]
WantedBy=default.target
