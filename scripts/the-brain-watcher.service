# The Brain File Watcher — systemd user service TEMPLATE
#
# Do not copy this file by hand. It carries placeholders that
# scripts/install-watcher.sh fills in, so the checkout can live anywhere and
# have any name:
#
#   scripts/install-watcher.sh                          # this checkout
#   scripts/install-watcher.sh --extras media-filer     # also start that watcher
#   scripts/install-watcher.sh --root /opt/brain-copy   # a different checkout
#   scripts/install-watcher.sh --uninstall
#
# Check status:  systemctl --user status the-brain-watcher
# Logs:          journalctl --user -u the-brain-watcher -f

[Unit]
Description=The Brain File Watcher — auto-indexes brain + memory files into Qdrant
After=network.target

[Service]
Type=simple
WorkingDirectory=@BRAIN_ROOT@
ExecStart="@PNPM@" watch
Restart=on-failure
RestartSec=5
# Optional watchers beyond the main file watcher: media-filer, poke-agy, all.
# Empty means none. See core/watch-extras.ts.
Environment=BRAIN_WATCH_EXTRAS=@WATCH_EXTRAS@
# Both optional (the leading '-'), so a missing file is not a start failure.
# Listed legacy-first: systemd lets a later file override an earlier one, so
# ~/.the-brain/.env (the documented location) wins where both exist.
EnvironmentFile=-%h/io-data/.env
EnvironmentFile=-%h/.the-brain/.env

[Install]
WantedBy=default.target
