# The Brain File Watcher — systemd user service
#
# Install:
#   cp scripts/the-brain-watcher.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable the-brain-watcher
#   systemctl --user start the-brain-watcher
#
# Check status:
#   systemctl --user status the-brain-watcher
#   journalctl --user -u the-brain-watcher -f
#
# Stop:
#   systemctl --user stop the-brain-watcher
#
# Adjust WorkingDirectory and EnvironmentFile below if your checkout or env
# file live elsewhere; systemd cannot resolve those paths itself.

[Unit]
Description=The Brain File Watcher — auto-indexes brain + memory files into Qdrant
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/the-brain
ExecStart=%h/.local/share/pnpm/pnpm watch
Restart=on-failure
RestartSec=5
EnvironmentFile=%h/io-data/.env

[Install]
WantedBy=default.target
